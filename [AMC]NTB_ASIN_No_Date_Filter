asin_metrics AS (
SELECT
  tracked_asin,
  -- report_month 제거됨
  
  -- [1] NTB Metrics
  SUM(CAST(new_to_brand_total_product_sales AS DECIMAL(18, 2))) AS ntb_total_product_sales,
  SUM(new_to_brand_total_purchases) AS ntb_total_purchases,
  
  -- [2] Total Metrics (Halo 포함)
  SUM(CAST(total_product_sales AS DECIMAL(18, 2))) AS total_product_sales,
  SUM(total_purchases) AS total_purchase,
  
  -- [3] Promoted Metrics (Direct)
  SUM(CAST(product_sales AS DECIMAL(18, 2))) AS promoted_product_sales,
  SUM(purchases) AS promoted_purchases
  
FROM
  amazon_attributed_events_by_conversion_time
WHERE
  tracked_asin IN (SELECT asin_id FROM target_asin_list)
  AND tracked_asin IS NOT NULL
  AND conversion_event_dt >= DATE '2025-01-01'
  AND conversion_event_dt <= DATE '2025-12-31'
GROUP BY
  tracked_asin -- report_month 제거됨
)
SELECT
tal.asin_id,

-- NTB
COALESCE(ROUND(am.ntb_total_product_sales, 0), 0) AS ntb_total_product_sales,
COALESCE(am.ntb_total_purchases, 0) AS ntb_total_purchases,

-- Total (Halo 포함)
COALESCE(ROUND(am.total_product_sales, 0), 0) AS total_product_sales,
COALESCE(am.total_purchase, 0) AS total_purchase,

-- Promoted (직접 매출)
COALESCE(ROUND(am.promoted_product_sales, 0), 0) AS promoted_product_sales,
COALESCE(am.promoted_purchases, 0) AS promoted_purchases

FROM
target_asin_list tal
LEFT JOIN asin_metrics am ON tal.asin_id = am.tracked_asin
